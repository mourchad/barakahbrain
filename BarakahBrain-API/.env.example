# BarakahBrain API Environment Variables
# Copy this file to .env and fill in your actual values

# ─── CORE API ─────────────────────────────────────────────────────────
PORT=3000

# REQUIRED: Strong JWT secret (min 32 chars, use: openssl rand -base64 32)
JWT_SECRET=change-this-to-a-strong-secret-min-32-chars

# CORS: Comma-separated list of allowed origins
# Example: https://example.com,https://www.example.com
# Leave empty to reject all origins (unless in localhost)
CORS_ORIGIN=https://example.com

# ─── DATABASE ──────────────────────────────────────────────────────────
# Optional: path to sqlite database (default: ./database.sqlite)
# Only needed if using volumes on Render for persistent storage
# DB_PATH=/usr/src/app/database.sqlite

# ─── SMTP (EMAIL CONFIGURATION) ────────────────────────────────────────
# OPTIONAL: If not set, password reset codes are printed to console only
# This is convenient for testing but insecure in production

# OPTION 1: Mailtrap (Recommended for testing)
# Sign up: https://mailtrap.io (500 emails/month free)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_mailtrap_user_id
SMTP_PASS=your_mailtrap_password

# OPTION 2: Gmail (Free, requires App Password)
# Setup: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-16-char-app-password

# OPTION 3: SendGrid (100 emails/day free)
# Sign up: https://sendgrid.com
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTION 4: Brevo/Sendinblue (300 emails/day free)
# Sign up: https://brevo.com
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-api-key

# Sender email for password reset (change per your setup)
SMTP_FROM=noreply@barakabrain.com

# ─── INITIAL ADMIN PASSWORD ───────────────────────────────────────────
# Optional: specify initial superadmin password
# If not set, a random one is generated and logged to console
# INIT_ADMIN_PWD=SuperSecure123!

# ─── NOTES ────────────────────────────────────────────────────────────
# For testing locally with Mailtrap:
#   1. Get credentials from Mailtrap Integration → Nodemailer
#   2. Fill SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS
#   3. Run: npm start
#   4. Test: curl -X POST http://localhost:3000/api/auth/forgot-password \
#      -H 'Content-Type: application/json' -d '{"email":"test@example.com"}'
#   5. Check Mailtrap dashboard for received email
#
# For production on Render:
#   1. Complete setup locally and test
#   2. Push to GitHub
#   3. Create Web Service on Render
#   4. Copy all SMTP_* variables to Render Environment dashboard
#   5. Render auto-redeploys with new config
#
# More details: See GUIDE_SMTP_CONFIG.md
