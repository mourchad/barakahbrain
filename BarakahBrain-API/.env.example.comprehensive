# BarakahBrain API Environment Variables
# Copy this file to .env and fill in your actual values
# 
# Security Note: Never commit .env with real secrets!
# Use GitHub Secrets for CI/CD, Render Environment Variables for production

# ─── CORE API ─────────────────────────────────────────────────────────
PORT=3000

# Node.js environment (development|production|test)
# development: verbose logging, smaller payloads
# production: minimal logging, performance optimized
NODE_ENV=development

# REQUIRED: Strong JWT secret for token signing (min 32 chars)
# Generate secure secret: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-this!!!

# CORS: Comma-separated list of allowed origins
# Examples for Render deployment:
#   https://barakahbrain.onrender.com
#   https://www.barakahbrain.com,https://barakahbrain.com
# Local development:
#   http://localhost,http://localhost:3000,http://localhost:5000
# For development (NOT SECURE for production):
#   *  (allows all origins)
CORS_ORIGIN=http://localhost,http://localhost:3000

# ─── DATABASE ──────────────────────────────────────────────────────────
# Optional: path to sqlite database (default: ./database.sqlite)
# Use this if you have a custom volume mounted on Render
# Example for Docker: /app/data/database.sqlite
DB_PATH=./database.sqlite

# ─── ADMIN INITIALIZATION ──────────────────────────────────────────────
# Initial superadmin password (only used on first server start)
# Change to a strong password in production
# If not set, a random password is generated and logged on startup
INIT_ADMIN_PWD=SuperAdmin123!@#

# ─── SMTP (EMAIL CONFIGURATION) ────────────────────────────────────────
# Email sending is OPTIONAL but required for password reset feature
# Without SMTP configured, password reset codes print to console only
#
# Choose ONE of the providers below OR skip entirely for console-only mode

# Option 1: MAILTRAP (Recommended for testing)
# ─────────────────────────────────────────
# Free: 500 emails/month
# Setup: https://mailtrap.io
# Services: Mailtrap (testing) → email logs in UI
#
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=1234567@inbox.mailtrap.io
# SMTP_PASS=your-mailtrap-api-token
# SMTP_FROM=noreply@barakahbrain.local

# Option 2: GMAIL (Personal/Small scale)
# ─────────────────────────────────────
# Free: Unlimited
# Setup: https://myaccount.google.com/apppasswords
# Note: Enable 2FA, generate App Password (16 chars)
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx (App Password, not account password!)
# SMTP_FROM=your-email@gmail.com

# Option 3: SENDGRID (Production)
# ─────────────────────────────
# Free: 100 emails/day, paid plans start at $10/mo
# Setup: https://app.sendgrid.com/settings/api_keys
# Create an API Key
#
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key-here
# SMTP_FROM=noreply@your-domain.com

# Option 4: BREVO (Formerly Sendinblue)
# ─────────────────────────────────────
# Free: 300 emails/day
# Setup: https://app.brevo.com/settings/account
# Create new SMTP user and password
#
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-brevo-email@example.com
# SMTP_PASS=your-brevo-smtp-password
# SMTP_FROM=noreply@your-domain.com

# ─── DEPLOYMENT PLATFORMS ──────────────────────────────────────────────
# For Render.com:
# - Create a new Web Service
# - Connect your GitHub repository
# - Build command: npm install && npm run migrate
# - Start command: npm start
# - Add these Environment Variables via Render dashboard
#
# For Docker/Docker Compose:
# - Copy this file to .env in the project root
# - Run: docker-compose up
# - Files will be mounted as volumes
#
# For GitHub Actions CI/CD:
# - Store secrets in GitHub Settings → Secrets and variables → Actions
# - Reference as: ${{ secrets.JWT_SECRET }} in workflows

# ─── TEST ENDPOINTS ────────────────────────────────────────────────────
# Once configured, test your SMTP setup:
#
# npm run test-smtp your-test-email@example.com
#
# Or test via API:
#
# curl -X POST http://localhost:3000/api/auth/forgot-password \
#   -H "Content-Type: application/json" \
#   -d '{"email":"test@example.com"}'
#
# Check your email for the password reset link!

# ─── SECURITY NOTES ────────────────────────────────────────────────────
# 🔒 Change JWT_SECRET to a unique value for each environment
# 🔒 Use strong passwords (min 16 chars, mixed case, numbers, symbols)
# 🔒 Never share or commit .env files
# 🔒 Rotate credentials periodically
# 🔒 Use HTTPS in production (Render auto-provides)
# 🔒 Enable 2FA on email/SMTP accounts
# 🔒 Monitor logs for suspicious auth failures

# ─── TROUBLESHOOTING ───────────────────────────────────────────────────
# "Server won't start":
#   → Check that JWT_SECRET is set
#   → Verify PORT is not in use (default 3000)
#
# "SMTP not working":
#   → Run: npm run test-smtp your-email@example.com
#   → Check SMTP credentials are correct
#   → Verify port 587/465 is not blocked
#
# "CORS errors":
#   → Add your frontend URL to CORS_ORIGIN
#   → Example: https://myapp.onrender.com
#
# "Database locked":
#   → SQLite uses file locks, check no other process uses database.sqlite
#   → Consider migrating to PostgreSQL for concurrent access
